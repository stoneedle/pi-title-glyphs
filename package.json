    "status",
    "tui"
  ],
  "license": "MIT",
  "author": "t0mj",
  "contributors": ["stoneedle"],
  "homepage": "https://github.com/stoneedle/pi-title-glyphs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoneedle/pi-title-glyphs.git"
  },
  "bugs": {
    "url": "https://github.com/stoneedle/pi-title-glyphs/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
